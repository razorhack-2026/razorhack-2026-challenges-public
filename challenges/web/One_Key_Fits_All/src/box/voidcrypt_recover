#!/usr/bin/env python3
"""VoidCrypt Recovery Utility — internal gang tooling, found on this host."""
import argparse
import sys
import time

from cryptography.fernet import Fernet, InvalidToken

RED = "\033[91m"
GREEN = "\033[92m"
YELLOW = "\033[93m"
CYAN = "\033[96m"
BOLD = "\033[1m"
RESET = "\033[0m"
CLEAR = "\033[2J\033[H"

BANNER = f"""{RED}{BOLD}
 __      __   _  _____                 _
 \\ \\    / /  (_)|  __ \\               | |
  \\ \\  / /__  _ | |  | | ___ _ __ _   _ _ __ | |_
   \\ \\/ / _ \\| ||____/ / __| '__| | | | '_ \\| __|
    \\  / (_) | |      | (__| |  | |_| | |_) | |_
     \\/ \\___/|_|       \\___|_|   \\__, | .__/ \\__|
                                   __/ | |
                                  |___/|_|
          R E C O V E R Y   U T I L I T Y   v2.6
{RESET}"""


def slow_print(lines, delay=0.35):
    for line in lines:
        print(line)
        time.sleep(delay)


def fail(reason):
    print(BANNER)
    print(f"{YELLOW}[VoidCrypt] validating recovery key...{RESET}")
    time.sleep(0.6)
    print(f"{RED}[VoidCrypt] key rejected: {reason}{RESET}")
    print(f"{RED}[VoidCrypt] nice try. that is not how you get your files back.{RESET}")
    print(f"{RED}[VoidCrypt] contact support through the channel you were already given.{RESET}")
    sys.exit(1)


def main():
    ap = argparse.ArgumentParser(prog="voidcrypt_recover")
    ap.add_argument("--key", required=True, help="recovery key")
    ap.add_argument("locked_file", help="path to the locked payload")
    args = ap.parse_args()

    try:
        with open(args.locked_file, "rb") as fh:
            blob = fh.read()
    except OSError as exc:
        fail(f"could not read {args.locked_file!r} ({exc})")
        return

    try:
        fernet = Fernet(args.key.encode())
    except Exception:
        fail("malformed key")
        return

    try:
        payload = fernet.decrypt(blob)
    except InvalidToken:
        fail("key does not match this payload")
        return

    print(BANNER)
    slow_print([
        f"{CYAN}[VoidCrypt] key accepted.{RESET}",
        f"{CYAN}[VoidCrypt] locating payload header...{RESET}",
        f"{CYAN}[VoidCrypt] decrypting...{RESET}",
    ], delay=0.5)
    print(f"{GREEN}[VoidCrypt] decryption successful.{RESET}")
    time.sleep(0.4)

    rows = [
        ["OT NETWORK SEGMENTATION", "ALARM"],
        ["FIELD CONTROLLER LINK", "LOCKED"],
        ["TELEMETRY INGEST", "ALARM"],
        ["SITE AUTHENTICATION", "LOCKED"],
    ]

    def render(rows, footer):
        print(CLEAR)
        print(f"{BOLD}{CYAN}=== RAZERPOWERCO OT STATUS - RECOVERY IN PROGRESS ==={RESET}")
        print()
        for name, status in rows:
            color = GREEN if status in ("NOMINAL", "ONLINE") else RED
            print(f"  {name:<28} [{color}{status:^8}{RESET}]")
        print()
        print(footer)

    render(rows, "stabilizing systems...")
    time.sleep(1.0)

    flip_order = [0, 3, 1, 2]
    statuses_after = {0: "NOMINAL", 3: "ONLINE", 1: "ONLINE", 2: "NOMINAL"}
    for idx in flip_order:
        rows[idx][1] = statuses_after[idx]
        render(rows, "stabilizing systems...")
        time.sleep(0.7)

    render(rows, f"{GREEN}all systems nominal.{RESET}")
    time.sleep(0.5)

    text = payload.decode(errors="replace").strip()
    flag_line = text.splitlines()[-1]
    print()
    print(f"{GREEN}{BOLD}+{'-' * (len(flag_line) + 2)}+{RESET}")
    print(f"{GREEN}{BOLD}| {flag_line} |{RESET}")
    print(f"{GREEN}{BOLD}+{'-' * (len(flag_line) + 2)}+{RESET}")
    print()


if __name__ == "__main__":
    main()
