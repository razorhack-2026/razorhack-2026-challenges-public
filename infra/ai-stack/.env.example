# Copy to .env and fill in. Never commit .env.

# --- model (vLLM) ---------------------------------------------------------
# Only for the self-contained setup (model.yml). The event hosts run vLLM from
# Razorhack-Infra (hosts/ai/compose.yml) with this same model.
# Event model: Qwen3-30B-A3B, GPTQ-Int4 build, served as `event` (LLM_MODEL below).
# Every challenge is calibrated on exactly this. ~17 GB of weights: it fits one
# L40S (event hosts, g6e.xlarge) or one RTX 5090 (linux-bld).
VLLM_MODEL=Qwen/Qwen3-30B-A3B-GPTQ-Int4
VLLM_TP=1
VLLM_GPU_UTIL=0.90
VLLM_MAX_LEN=16384
# host dir holding the Hugging Face cache (weights download here on first start)
HF_CACHE=/home/ubuntu/.cache/huggingface

# --- what the challenge apps see --------------------------------------------
# Self-contained: the vllm service on this network. For a model server elsewhere,
# use http://<your-model-host>:8000/v1.
LLM_BASE_URL=http://vllm:8000/v1
# the served model name; the apps ask for this, whatever VLLM_MODEL is
LLM_MODEL=event
LLM_BACKEND=vllm
# shared secret between the apps and vLLM (model.yml requires one):
#   python3 -c 'import secrets; print(secrets.token_hex(16))'
# The event hosts' vLLM has no key: Overprivileged Relay can read its own environment,
# so a key would leak. Their security group keeps players off port 8000 instead.
LLM_API_KEY=

# --- host ports contestants connect to ---------------------------------------
LOOSE_LIPS_PORT=8101
RELAY_PORT=8102
RELAY_ADMIN_PORT=8103

# set to 1 only if a reverse proxy that sets X-Forwarded-For sits in front
TRUST_PROXY=0
